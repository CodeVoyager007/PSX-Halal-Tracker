# Supabase project: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The public anon / publishable key. Never put the service_role key in the web app:
# it would be shipped to browsers. RLS policies in db/schema.sql protect the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
